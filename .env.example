# --- LIVE: Supabase (Postgres + Auth + Storage) ---
# From Supabase project settings. DATABASE_URL is the pooled/direct Postgres URL.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LIVE: Anthropic (Claude vision OCR — used from Phase 3) ---
# Use a SEPARATE key/workspace for PermitKeep so OCR cost tracking is clean.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=

# --- Inngest (background OCR job). Optional in local dev: run
#     `npx inngest-cli@latest dev` next to `npm run dev`. ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ---
APP_URL=http://localhost:3000
# Used to sign one-click acknowledge tokens (Phase 4). Any long random string.
REMINDER_TOKEN_SECRET=

# --- STUBBED until their phase (leave blank for now) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
